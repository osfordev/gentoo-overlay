#
# The tw00 based on X99 V102A motherboard has
#    vendor_id  : GenuineIntel
#    cpu family : 6
#    model      : 63
#    model name : Intel(R) Xeon(R) CPU E5-2620 v3 @ 2.40GHz
#    stepping   : 2
#
# gcc -march=native -Q --help=target | grep march
#
CFLAGS="-O2 -pipe -march=haswell"
CXXFLAGS="${CFLAGS}"
FCFLAGS="${CFLAGS}"
FFLAGS="${CFLAGS}"

#
# https://wiki.gentoo.org/wiki/CPU_FLAGS_X86
#
CPU_FLAGS_X86="aes avx avx2 bmi1 bmi2 f16c fma3 mmx mmxext pclmul popcnt rdrand sse sse2 sse3 sse4_1 sse4_2 ssse3"

# Twelve CPUs
MAKEOPTS="-j12"

#
# The tw00 based on X99 V102A motherboard has
# - 03:00.0 VGA compatible controller: NVIDIA Corporation GP106 [GeForce GTX 1060 6GB Rev. 2] (rev a1)
# - 03:00.1 Audio device: NVIDIA Corporation GP106 High Definition Audio Controller (rev a1)
# According to https://wiki.gentoo.org/wiki/NVIDIA/nvidia-drivers
#   make.conf: VIDEO_CARDS="nvidia"
#
VIDEO_CARDS="-* nvidia"

#
# https://wiki.gentoo.org/wiki/QEMU
# QEMU_SOFTMMU_TARGETS - system emulation targets https://ftp.fau.de/gentoo-portage/profiles/desc/qemu_softmmu_targets.desc
# QEMU_USER_TARGETS - userspace emulation targets https://ftp.fau.de/gentoo-portage/profiles/desc/qemu_user_targets.desc
#
QEMU_SOFTMMU_TARGETS="aarch64 arm i386 x86_64"
QEMU_USER_TARGETS="i386 x86_64"
