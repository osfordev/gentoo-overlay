#
# The LenovoLenovo IdeaPad Flex 10 has
# - Intel(R) Celeron(R) CPU  N2910
#    vendor_id  : GenuineIntel
#    cpu family : 6
#    model      : 55
#    model name : Intel(R) Celeron(R) CPU  N2910  @ 1.60GHz
#    stepping   : 3

#
# gcc -march=native -Q --help=target | grep march
#
CFLAGS="-O2 -pipe -march=silvermont"
CXXFLAGS="${CFLAGS}"
FCFLAGS="${CFLAGS}"
FFLAGS="${CFLAGS}"

#
# https://wiki.gentoo.org/wiki/CPU_FLAGS_X86
#
CPU_FLAGS_X86="mmx mmxext pclmul popcnt rdrand sse sse2 sse3 sse4_1 sse4_2 ssse3"

# Four CPUs
MAKEOPTS="-j4"

#
# LenovoLenovo IdeaPad Flex 10 has
# - VGA compatible controller [0300]: Intel Corporation Atom Processor Z36xxx/Z37xxx Series Graphics & Display [8086:0f31] (rev 0a)
#       Kernel driver in use: i915
#
VIDEO_CARDS="-* intel i915"

#
# LenovoLenovo IdeaPad Flex 10 has
# - Network controller [0280]: Qualcomm Atheros QCA9565 / AR9565 Wireless Network Adapter [168c:0036] (rev 01)
# - 0cf3:3004 Qualcomm Atheros Communications AR3012 Bluetooth 4.0
# - 13d3:5614 IMC Networks Lenovo EasyCamera
# - 04f3:024b Elan Microelectronics Corp. Touchscreen
#
USE="
  bluetooth
"
