#
# The tw05 based on ASUS N3150I-C motherboard has
#   Intel(R) Celeron(R) CPU
#    vendor_id  : GenuineIntel
#    cpu family : 6
#    model      : 76
#    model name : Intel(R) Celeron(R) CPU  N3150  @ 1.60GHz
#    stepping   : 3
#
# gcc -march=native -Q --help=target | grep march
#
CFLAGS="-O2 -pipe -march=silvermont"
CXXFLAGS="${CFLAGS}"
FCFLAGS="${CFLAGS}"
FFLAGS="${CFLAGS}"

#
# https://wiki.gentoo.org/wiki/CPU_FLAGS_X86
#
CPU_FLAGS_X86="aes mmx mmxext pclmul popcnt rdrand sse sse2 sse3 sse4_1 sse4_2 ssse3"

# Four CPUs
MAKEOPTS="-j4"

#
# The tw05 based on ASUS N3150I-C motherboard has
# - VGA compatible controller: Intel Corporation Device [8086:22b1] (rev 21)
# According to https://en.wikipedia.org/wiki/List_of_Intel_graphics_processing_units
# code 22B1 has code name Cherryview Braswell (Gen8LP)
# According to Feature support (https://wiki.gentoo.org/wiki/Intel) Gen 4 and higher is used "intel"
#   make.conf: VIDEO_CARDS="-* intel"
#   kernel:    CONFIG_EXTRA_FIRMWARE=???
#
VIDEO_CARDS="-* intel"

#
# https://wiki.gentoo.org/wiki/QEMU
# QEMU_SOFTMMU_TARGETS - system emulation targets https://ftp.fau.de/gentoo-portage/profiles/desc/qemu_softmmu_targets.desc
# QEMU_USER_TARGETS - userspace emulation targets https://ftp.fau.de/gentoo-portage/profiles/desc/qemu_user_targets.desc
#
QEMU_SOFTMMU_TARGETS="i386 x86_64"
QEMU_USER_TARGETS="i386 x86_64"
