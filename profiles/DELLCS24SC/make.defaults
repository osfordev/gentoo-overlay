#
# The Dell CS24-SC has
#    vendor_id  : GenuineIntel
#    cpu family : 6
#    model      : 23
#    model name : Intel(R) Xeon(R) CPU L5420  @ 2.50GHz
#    stepping   : 10
#
# gcc -march=native -Q --help=target | grep march
# У версіях GCC, де прапорець penryn не реалізовано як окреме ключове слово,
# для Intel Xeon L5420 слід використовувати значення core2 з ручним додаванням
# інструкції sse4.1
#
CFLAGS="-O2 -pipe -march=core2 -msse4.1"
CXXFLAGS="${CFLAGS}"
FCFLAGS="${CFLAGS}"
FFLAGS="${CFLAGS}"

#
# https://wiki.gentoo.org/wiki/CPU_FLAGS_X86
#
CPU_FLAGS_X86="mmx mmxext sse sse2 sse3 sse4_1 ssse3"

# Eight CPUs
MAKEOPTS="-j8"

#
# The Dell CS24-SC has
# - VGA compatible controller [0300]: ASPEED Technology, Inc. ASPEED Graphics Family [1a03:2000]
# According to https://wiki.gentoo.org/wiki/NVIDIA/nvidia-drivers
#   make.conf: VIDEO_CARDS=""
#
VIDEO_CARDS="-*"

#
# https://wiki.gentoo.org/wiki/QEMU
# QEMU_SOFTMMU_TARGETS - system emulation targets https://ftp.fau.de/gentoo-portage/profiles/desc/qemu_softmmu_targets.desc
# QEMU_USER_TARGETS - userspace emulation targets https://ftp.fau.de/gentoo-portage/profiles/desc/qemu_user_targets.desc
#
QEMU_SOFTMMU_TARGETS="i386 x86_64"
QEMU_USER_TARGETS="x86_64"
